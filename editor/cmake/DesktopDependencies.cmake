# Offline-only wrapper around pinned, permissively licensed vendored sources.
set(LYKO_VENDOR_DIR "${CMAKE_CURRENT_LIST_DIR}/../../third_party")
set(LYKO_SDL_ARCHIVE "${LYKO_VENDOR_DIR}/sdl3/SDL3-3.2.28.tar.gz")
file(SHA256 "${LYKO_SDL_ARCHIVE}" LYKO_SDL_HASH)
if(NOT LYKO_SDL_HASH STREQUAL "48b4cba694feacb6d4792a23bdb20e297a6d570fdbabd42b4601afc00bd2c818")
  message(FATAL_ERROR "Vendored SDL source checksum mismatch")
endif()
set(LYKO_SDL_SOURCE "${CMAKE_BINARY_DIR}/vendor/SDL3")
if(NOT EXISTS "${LYKO_SDL_SOURCE}/CMakeLists.txt")
  file(ARCHIVE_EXTRACT INPUT "${LYKO_SDL_ARCHIVE}" DESTINATION "${CMAKE_BINARY_DIR}/vendor")
endif()
set(SDL_SHARED OFF CACHE BOOL "" FORCE)
set(SDL_STATIC ON CACHE BOOL "" FORCE)
set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
set(SDL_TESTS OFF CACHE BOOL "" FORCE)
set(SDL_EXAMPLES OFF CACHE BOOL "" FORCE)
set(SDL_AUDIO OFF CACHE BOOL "" FORCE)
set(SDL_CAMERA OFF CACHE BOOL "" FORCE)
set(SDL_JOYSTICK OFF CACHE BOOL "" FORCE)
set(SDL_HAPTIC OFF CACHE BOOL "" FORCE)
set(SDL_HIDAPI OFF CACHE BOOL "" FORCE)
set(SDL_SENSOR OFF CACHE BOOL "" FORCE)
set(SDL_WAYLAND OFF CACHE BOOL "" FORCE)
set(SDL_OPENGL OFF CACHE BOOL "" FORCE)
set(SDL_OPENGLES OFF CACHE BOOL "" FORCE)
set(SDL_VULKAN OFF CACHE BOOL "" FORCE)
set(SDL_RENDER_GPU OFF CACHE BOOL "" FORCE)
add_subdirectory("${LYKO_SDL_SOURCE}" "${CMAKE_BINARY_DIR}/vendor/sdl-build" EXCLUDE_FROM_ALL)
add_library(lyko_imgui STATIC
  "${LYKO_VENDOR_DIR}/imgui/imgui.cpp" "${LYKO_VENDOR_DIR}/imgui/imgui_draw.cpp"
  "${LYKO_VENDOR_DIR}/imgui/imgui_tables.cpp" "${LYKO_VENDOR_DIR}/imgui/imgui_widgets.cpp"
  "${LYKO_VENDOR_DIR}/imgui/backends/imgui_impl_sdl3.cpp"
  "${LYKO_VENDOR_DIR}/imgui/backends/imgui_impl_sdlrenderer3.cpp")
target_include_directories(lyko_imgui SYSTEM PUBLIC "${LYKO_VENDOR_DIR}/imgui" "${LYKO_VENDOR_DIR}/imgui/backends")
target_link_libraries(lyko_imgui PUBLIC SDL3::SDL3-static)
